---
---

<button type="button" class="theme-toggle" aria-label="Toggle theme" title="Toggle theme">
	<svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<circle cx="12" cy="12" r="4" />
		<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
	</svg>
	<svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
	</svg>
</button>

<style>
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.5rem;
		background: transparent;
		border: none;
		cursor: pointer;
		line-height: 0;
	}

	.theme-icon-sun {
		display: inline;
	}

	.theme-icon-moon {
		display: none;
	}

	:global(.dark) .theme-icon-sun {
		display: none;
	}

	:global(.dark) .theme-icon-moon {
		display: inline;
	}
</style>

<script>
	import { initTheme, toggleTheme } from '../scripts/theme.js';

	initTheme();

	document.querySelectorAll('.theme-toggle').forEach((button) => {
		button.addEventListener('click', () => {
			toggleTheme();
		});
	});
</script>
