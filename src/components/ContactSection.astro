---
import Sticker from './ui/Sticker.astro';
import github from '../assets/icons/github.svg?raw';

// simple-icons ship no width/height/fill — add fill="currentColor" so the
// glyph inherits text color (same treatment as ProjectsSection/SkillsSection).
const githubIcon = github.replace('<svg', '<svg fill="currentColor" aria-hidden="true"');

const year = new Date().getFullYear();

const chipClasses =
  'inline-flex items-center gap-2 rounded-full border-2 border-ink px-4 py-2 font-mono text-sm font-bold shadow-hard press';
---

<footer id="contact" class="relative overflow-hidden bg-accent">
  <!-- Decorative shapes — page motif, clipped by the footer. -->
  <div
    aria-hidden="true"
    data-drift
    class="pointer-events-none absolute -left-16 top-12 h-64 w-64 rotate-12 rounded-3xl border-4 border-ink/10 bg-card/25"
  ></div>
  <div
    aria-hidden="true"
    data-drift
    class="pointer-events-none absolute -bottom-10 -right-20 h-80 w-80 -rotate-6 rounded-3xl border-4 border-ink/10 bg-ink/10"
  ></div>

  <div class="relative mx-auto flex max-w-6xl flex-col items-center gap-8 px-6 py-24 text-center">
    <p data-reveal class="font-mono text-xs font-bold uppercase tracking-widest text-ink-strong">get in touch</p>

    <div class="relative" data-reveal style="--reveal-delay: 80ms">
      <h2 class="inline-block rotate-1 rounded-2xl border-4 border-ink bg-badge-green px-5 py-2 text-5xl font-black tracking-tight text-ink-strong shadow-hard md:text-[--text-display]">Let&rsquo;s talk.</h2>
    </div>

    <p data-reveal style="--reveal-delay: 160ms" class="max-w-xl text-base font-medium text-ink-strong opacity-80 md:text-lg">
      My inbox is open. Drop me a line &mdash; I might even write back!
    </p>

    <div data-reveal style="--reveal-delay: 240ms" class="relative">
      <div class="flex w-full max-w-md items-stretch rounded-2xl border-4 border-ink bg-primary shadow-hard">
        <span id="email-address" class="flex-1 px-4 py-3 text-left font-mono text-sm font-bold text-ink-strong sm:text-base">ryangking@me.com</span>
        <button
          type="button"
          data-copy-email
          data-copy-label="Copy"
          aria-live="polite"
          class="press shrink-0 rounded-r-xl border-l-4 border-ink bg-badge-yellow px-4 py-3 text-sm font-black uppercase tracking-wide text-ink-strong"
        >Copy</button>
      </div>
      <span class="sr-only" aria-live="polite" data-copy-status></span>
      <a
        href="mailto:ryangking@me.com"
        class="mt-3 inline-block text-sm font-bold text-ink-strong underline decoration-2 underline-offset-4 transition-opacity hover:opacity-80"
        >Prefer your own mail app? Open a draft →</a
      >
      <Sticker
        label="OPEN TO WORK"
        rotate={6}
        color="green"
        class="pointer-events-none absolute -top-5 -right-8 md:-right-14"
      />
    </div>

    <div data-reveal style="--reveal-delay: 320ms" class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="https://github.com/octini"
        aria-label="GitHub: github.com/octini"
        class={`${chipClasses} bg-secondary text-ink-strong`}
      >
        <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.27-.82 2.15 0 3.07 1.87 3.75 3.65 3.95-.29.25-.44.73-.44 1.48 0 1.07.01 1.93.01 2.2 0 .21-.15.46-.55.38A8.013 8.013 0 0 1 0 8c0-4.42 3.58-8 8-8Z"
          />
        </svg>
        <span class="underline-swipe">github.com/octini</span>
      </a>
      <a
        href="https://linkedin.com/in/ryangeeking"
        aria-label="LinkedIn: linkedin.com/in/ryangeeking"
        class={`${chipClasses} bg-badge-yellow text-ink-strong`}
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"
          />
        </svg>
        <span class="underline-swipe">linkedin.com/in/ryangeeking</span>
      </a>
      <a
        href="tel:7858931832"
        aria-label="Phone: 785-893-1832"
        class={`${chipClasses} bg-badge-green text-ink-strong`}
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"
          />
        </svg>
        <span class="underline-swipe">785-893-1832</span>
      </a>
    </div>
  </div>

  <div class="mt-12 border-t-4 border-ink bg-ink px-6 py-3 text-sm font-bold text-paper">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3">
      <span>© {year} Ryan King</span>
      <div class="flex items-center gap-4">
        <a href="https://github.com/octini" target="_blank" rel="noopener noreferrer" aria-label="GitHub profile" class="inline-flex items-center gap-1.5"><span class="inline-block h-4 w-4 [&_svg]:h-full [&_svg]:w-full" set:html={githubIcon}></span><span class="underline-swipe">GitHub</span></a>
        <a href="https://www.linkedin.com/in/ryangeeking" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile" class="inline-flex items-center gap-1.5">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"
            />
          </svg>
          <span class="underline-swipe">LinkedIn</span>
        </a>
        <a href="#top" class="underline-swipe">Back to top ↑</a>
      </div>
    </div>
  </div>
</footer>

<script>
  const copyBtn = document.querySelector('[data-copy-email]');
  let resetTimer: ReturnType<typeof setTimeout> | undefined;
  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText('ryangking@me.com');
      if (copyBtn) copyBtn.textContent = 'Copied!';
      clearTimeout(resetTimer);
      resetTimer = setTimeout(() => {
        if (copyBtn) copyBtn.textContent = 'Copy';
      }, 2000);
    } catch {
      // Clipboard unavailable/denied — select the address so ⌘C still works.
      const range = document.createRange();
      range.selectNodeContents(document.getElementById('email-address'));
      const sel = window.getSelection();
      sel.removeAllRanges();
      sel.addRange(range);
      if (copyBtn) copyBtn.textContent = 'Press ⌘C';
      const status = document.querySelector('[data-copy-status]');
      if (status) status.textContent = 'Copy blocked — address selected, press Command C to copy';
      clearTimeout(resetTimer);
      resetTimer = setTimeout(() => {
        if (copyBtn) copyBtn.textContent = copyBtn.getAttribute('data-copy-label') || 'Copy';
      }, 2000);
    }
  });
</script>
