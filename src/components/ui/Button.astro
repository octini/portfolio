---
interface Props {
  variant?: 'primary' | 'secondary' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
}

const { variant = 'primary', size = 'md', href, type = 'button', class: className = '', ...rest } = Astro.props;

const variants = {
  primary: 'bg-ink text-paper border-ink',
  secondary: 'bg-accent text-ink-strong border-ink',
  outline: 'bg-paper text-ink border-ink',
} as const;

const sizes = {
  sm: 'px-4 py-1.5 text-sm rounded-lg',
  md: 'px-6 py-2.5 text-base rounded-xl',
  lg: 'px-8 py-3.5 text-lg rounded-2xl',
} as const;

const base =
  'press inline-flex cursor-pointer select-none items-center justify-center gap-2 border-3 font-bold shadow-hard';

const classes = `${base} ${variants[variant]} ${sizes[size]} ${className}`;
---

{href ? (
  <a href={href} class={classes} {...rest}>
    <slot />
  </a>
) : (
  <button type={type} class={classes} {...rest}>
    <slot />
  </button>
)}
