---
interface Props {
  value: string;
  caption?: string;
  class?: string;
}

const { value, caption, class: className = '' } = Astro.props;
---

<div class={`flex flex-col items-start ${className}`}>
  <span class="text-6xl font-black leading-none tracking-tight">{value}</span>
  {caption && <span class="mt-2 text-xs font-bold uppercase tracking-widest text-muted">{caption}</span>}
</div>
