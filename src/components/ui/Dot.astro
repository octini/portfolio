---
interface Props {
  /** Tailwind bg utility (e.g. "bg-primary") or a token name ("primary", "accent", "yellow", ...). */
  color: string;
  class?: string;
}

const { color, class: className = '' } = Astro.props;

const named = {
  accent: 'bg-accent',
  primary: 'bg-primary',
  secondary: 'bg-secondary',
  yellow: 'bg-badge-yellow',
  pink: 'bg-badge-pink',
  green: 'bg-badge-green',
  blue: 'bg-badge-blue',
  purple: 'bg-badge-purple',
  ink: 'bg-ink',
  paper: 'bg-paper',
} as const;

const resolved = color.startsWith('bg-') ? color : ((named as Record<string, string>)[color] ?? 'bg-primary');
---

<span aria-hidden="true" class={`inline-block h-4 w-4 border-3 border-ink ${resolved} ${className}`} />
