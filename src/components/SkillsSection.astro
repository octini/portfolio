// Two icon families share these tiles:
// - simple-icons ship no width/height/fill — add sizing + fill="currentColor"
//   so the glyph inherits the tile's ink text color and respects the palette.
// - Lucide ships stroke="currentColor" fill="none" plus fixed width/height —
//   strip the fixed size, size via class, leave stroke/fill untouched.
function inlineIcon(raw: string): string {
  if (raw.includes('stroke="currentColor"')) {
    const sized = raw.replace(
      /<svg([^>]*)>/,
      (_match, attrs: string) =>
        `<svg${attrs.replace(/\s+width="[^"]*"/, '').replace(/\s+height="[^"]*"/, '')} aria-hidden="true">`,
    );
    return sized.replace('class="lucide', 'class="h-8 w-8 lucide');
  }
  return raw.replace(
    '<svg',
    '<svg class="h-8 w-8" fill="currentColor" aria-hidden="true"',
  );
}
---

<section id="skills" aria-labelledby="skills-heading" class="border-b-4 border-ink pb-10 md:pb-16">
   <div class="flex flex-col items-start" data-reveal>
     <h2 id="skills-heading" class="mt-6 inline-block -rotate-1 rounded-2xl border-4 border-ink bg-badge-pink px-5 py-2 text-4xl font-black tracking-tight text-ink-strong shadow-hard">I’ve got skills</h2>
  </div>

  <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-6">
    {
      categories.map((category, index) => (
        <article
          id={category.id}
          data-reveal
          style={`--reveal-delay: ${index * 60}ms`}
          class={`rounded-3xl border-4 border-ink p-6 shadow-hard press ${category.color} ${category.span}`}
        >
          <h3 class="text-xl font-black text-ink-strong">{category.name}</h3>
          <ul class="mt-6 flex flex-wrap gap-3">
            {category.skills.map((skill) => (
              <li class="flex w-18 flex-col items-center gap-2">
                <span
                  class="flex h-12 w-12 items-center justify-center rounded-xl border-2 border-ink bg-paper text-ink"
                  set:html={inlineIcon(skill.icon)}
                />
                <span class="min-h-8 break-words text-center text-xs font-bold leading-4 text-ink-strong">
                  {skill.label}
                </span>
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>
